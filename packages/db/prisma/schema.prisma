// Colina — Prisma schema (Phase 2).
//
// Conventions (per phase brief):
// - Every model: cuid `id`, `createdAt`, `updatedAt`.
// - Visitor-facing text is stored as separate `*Ar` / `*En` columns
//   (matches the next-intl ar/en setup). No generic translations table.
// - Lead data (ContactMessage / MaintenanceRequest) is stored as submitted,
//   single columns — it is user input, not site copy.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

// Shared status for both lead inboxes (ContactMessage + MaintenanceRequest).
// One enum on purpose: Phase 12 manages both in the same "leads inbox" UI.
enum LeadStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
}

// The three enforcement points that record abuse (Phase 21a). One enum
// rather than a table of "reasons" so the Phase 21c dashboard can filter
// and count on a real column. Kept deliberately small: a new member is a
// schema change, which is the point — every value here must correspond to
// a place in the code that actually enforces something.
enum SecurityEventType {
  // A public POST endpoint's rate limiter refused a request.
  RATE_LIMITED
  // A hidden form field (honeypot) came back filled, so the submission is
  // treated as a bot's.
  HONEYPOT_CAUGHT
  // next-auth rejected admin credentials (unknown email, wrong password
  // or a malformed body).
  LOGIN_FAILED
}

model MachineCategory {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  nameAr        String
  nameEn        String
  slug          String    @unique
  descriptionAr String    @db.Text
  descriptionEn String    @db.Text
  image         String?
  machines      Machine[]
}

model Machine {
  id                 String          @id @default(cuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  nameAr             String
  nameEn             String
  slug               String          @unique
  categoryId         String
  category           MachineCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shortDescriptionAr String          @db.Text
  shortDescriptionEn String          @db.Text
  descriptionAr      String          @db.Text
  descriptionEn      String          @db.Text
  specsAr            String          @db.Text
  specsEn            String          @db.Text
  datasheetUrl       String?
  images             MachineImage[]
  // Admin-curated: the public home page's featured strip selects on this.
  // Defaults to false so a newly created machine never appears on the
  // marketing site until somebody chooses it. There is deliberately no
  // database constraint on how many rows may be true — the home page caps
  // what it renders, and the admin form states that cap.
  featured           Boolean         @default(false)
  // Related machines: implicit self-referential many-to-many
  // ("RelatedMachines" join table, managed by Prisma).
  // Chosen over an explicit join model because it needs no extra model
  // file and covers the Phase 5 "related machines" grid with a single
  // `include: { relatedMachines: true }`. The link is directional:
  // seed both directions when the relation should read as symmetric.
  relatedMachines    Machine[]       @relation("RelatedMachines")
  relatedTo          Machine[]       @relation("RelatedMachines")

  @@index([categoryId])
}

model MachineImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  machineId String
  machine   Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  url       String
  // Display order in the gallery, lowest first. Named `position` (not
  // `order`) because ORDER is a reserved word in PostgreSQL.
  position  Int      @default(0)

  @@index([machineId])
}

// One complete production line Colina has serviced (e.g. "Bakery line").
// Mirrors MachineCategory's conventions, but the long-form descriptions are
// optional here: a production line can be named and listed before anyone has
// written copy for it. `sortOrder` is the admin's display order (lowest first)
// and is independent of createdAt, so a line can be moved without being
// re-created. The cover photo is optional; the public section falls back to
// the first item's after-photo when it is empty.
model MaintenanceCategory {
  id            String                @id @default(cuid())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  nameAr        String
  nameEn        String
  slug          String                @unique
  descriptionAr String?               @db.Text
  descriptionEn String?               @db.Text
  imageUrl      String?
  sortOrder     Int                   @default(0)
  items         MaintenanceShowcase[]
}

model MaintenanceService {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  titleAr       String
  titleEn       String
  slug          String   @unique
  descriptionAr String   @db.Text
  descriptionEn String   @db.Text
  scopeAr       String   @db.Text
  scopeEn       String   @db.Text
  icon          String
}

model MaintenanceRequest {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  name         String
  company      String?
  phone        String
  email        String?
  machineModel String?
  message      String     @db.Text
  status       LeadStatus @default(NEW)
}

// One maintenance job shown to a visitor as a before/after comparison: the
// same machine photographed twice. Both photos are stored as absolute URLs and
// BOTH are required — a comparison with one half missing is not a comparison,
// so the row is only ever written once the pair exists.
//
// No slug: the item is identified by its id, like Partner and Agent. Each row
// belongs to one maintenance category (a production line). `categoryId` is
// nullable so the rows created before categories existed stay valid; the admin
// form requires a choice before it will save one. The delete rule matches
// Machine -> MachineCategory: Restrict, so a line with items cannot disappear
// silently underneath them.
model MaintenanceShowcase {
  id             String               @id @default(cuid())
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  categoryId     String?
  category       MaintenanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameEn         String
  nameAr         String
  // Optional long form. Nullable rather than an empty-string default: "this
  // job has no written description" and "the description is the empty string"
  // are the same thing to a reader, so the column stays honest about which
  // rows were ever given one.
  descriptionEn  String?              @db.Text
  descriptionAr  String?              @db.Text
  // The pair, in the order they must be read. Stored on the row rather than in
  // a child table because the comparison is an atomic unit: there is exactly
  // one before and one after, and nothing else can point at either half.
  beforeImageUrl String
  afterImageUrl  String

  @@index([categoryId])
}

model Partner {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nameAr    String
  nameEn    String
  // Nullable for the same reason MachineCategory.image and NewsPost.image
  // are: a partner has a name long before Colina has its logo, and the
  // admin form's own "clear logo" control could not save a cleared value
  // while this column was required. `logo: parsed.data.logo || null` in
  // the Server Action, and `?? ''` in the edit form, as for the others.
  logo      String?
}

model Agent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  countryAr String
  countryEn String
  cityAr    String?
  cityEn    String?
  addressAr String?
  addressEn String?
  phone     String?
  email     String?
}

model NewsPost {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  titleAr     String
  titleEn     String
  slug        String   @unique
  bodyAr      String   @db.Text
  bodyEn      String   @db.Text
  image       String?
  publishedAt DateTime @default(now())
}

model ContactMessage {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  name      String
  email     String?
  phone     String?
  message   String     @db.Text
  status    LeadStatus @default(NEW)
}

model AdminUser {
  id                          String     @id @default(cuid())
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  email                       String     @unique
  // Argon2id hash (see Phase 9). Never plaintext, never logged.
  passwordHash                String
  role                        AdminRole  @default(EDITOR)
  // Password reset (Phase 9): SHA-256 hash of the single-use raw token —
  // the raw token itself is never stored. Null = no reset in flight.
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  auditLogs                   AuditLog[]
}

model AuditLog {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  entity      String

  @@index([adminUserId])
}

// Blocked / suspicious traffic, recorded by the enforcement points
// themselves (Phase 21a). Distinct from AuditLog, which records what
// authenticated staff did on purpose: these rows are written by the code
// refusing a request, never by a human, and are the raw material for the
// Phase 21c security/abuse dashboard.
//
// Append-only in practice. `updatedAt` exists only because the
// schema-wide convention gives every model one; no code path updates a
// row here.
model SecurityEvent {
  id        String            @id @default(cuid())
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  type      SecurityEventType
  // Which endpoint or form was targeted, as the code names it: "contact",
  // "maintenance-request", "admin-login". A fixed, code-owned vocabulary —
  // not free text — so the dashboard can group by it.
  source    String
  // Best-effort client IP from the request headers, for correlating bursts
  // across sources. Nullable because it is only ever best-effort: an
  // unknown address must not stop the row from being recorded (and the
  // header itself is attacker-controlled on unprotected hosting, see
  // SECURITY.md). Stored because attributing abuse is the point of the log.
  ip        String?
  // Short free-text context for a human reviewer, e.g. the email attempted
  // on a failed login. Never a password, never a password hash, never a
  // submitted message body. Truncated by the write helper.
  detail    String?           @db.Text

  // The two dashboard queries Phase 21c starts with: newest first, and
  // "show me every rate-limited request".
  @@index([createdAt])
  @@index([type])
}

// Privacy-respecting traffic counting (Phase 21b): one row per page per day
// per language, holding nothing that identifies a visitor.
//
// Deliberately NOT a per-visit table. There is no row per request, no IP and
// no user-agent column here (unlike SecurityEvent above, whose whole purpose
// is attributing abuse) — a visit only ever increments a counter on a row that
// already existed. That is the property the privacy policy promises, so the
// schema is what enforces it: there is nowhere to put an identifier.
//
// `path` is locale-agnostic ("/machines/colina-pack-s", never
// "/en/machines/..."), so the same page is one addressable thing regardless of
// the language it was served in; `locale` stays a separate column (below) so
// the dashboard can still break the same page down by language.
model PageViewDaily {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // A calendar day with no time component and no timezone: PostgreSQL `date`.
  // Chosen over `DateTime` so "one row per day" is a storage guarantee rather
  // than a convention every writer has to remember — the column physically
  // cannot hold 13:37, so no future caller can write a timestamp into it and
  // silently create a second row for the same day. Which day a visit belongs
  // to is the server's calendar day (UTC on the deployed container), NOT the
  // visitor's: deriving it from the visitor would mean storing something
  // about them, and per-visitor precision is not what this table is for.
  date      DateTime @db.Date
  // The route, as the page itself knows it: a static path ("/", "/privacy")
  // or one built from a slug ("/categories/production-lines"). Written by the
  // page, never taken from the raw request URL, and validated against the
  // public route list by the endpoint that receives it.
  path      String
  // "ar" or "en" — the language this row's views were served in. Not part of
  // `path` (see above), kept as its own column so a breakdown by language is
  // a GROUP BY rather than a string match.
  locale    String
  // Views accumulated for this page on this day. Only ever moves by +1, via
  // the atomic upsert in `page-views.ts`; `increment` is a database-side
  // arithmetic, so concurrent requests cannot lose a count.
  count     Int      @default(0)

  // Doubles as the upsert target and as the index the dashboard reads: it
  // leads with `date` (time-range queries) and covers `path` within a range
  // ("which pages are popular this month").
  @@unique([date, path, locale])
}

// Site-wide settings the public site reads (Phase 32a). A singleton: the
// row's id is always "main", so there is exactly one place to edit and no
// list to manage. New settings arrive as additive nullable columns — the
// factory-location fields land in a later stage — never as a second row.
//
// The WhatsApp number is stored as normalized international digits without
// "+" (e.g. "201001234567"), because that is exactly what a wa.me link
// takes. Null means "no WhatsApp": the public site hides the button. The two
// greetings are optional pre-filled messages, one per language.
//
// The public contact details are display values: contactPhone keeps the
// formatting the owner typed (trimmed) because visitors read it as written,
// and contactEmail is trimmed/lowercased. Null means "not shown" — the public
// contact page hides that row.
//
// The factory location is optional as a group: latitude/longitude are the
// parsed pair (both null when no map is wanted), the addresses and working
// hours are free text per language, and mapsUrl is an optional https link for
// an "Open in maps" button. The admin no longer edits the coordinates — the
// columns stay because the web app still reads them until stage 34b removes
// the map. Existing stored pairs are left untouched.
model SiteSettings {
  id                String   @id @default("main")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  whatsappNumber    String?
  whatsappMessageEn String?  @db.Text
  whatsappMessageAr String?  @db.Text
  contactPhone      String?
  contactEmail      String?
  latitude          Float?
  longitude         Float?
  factoryAddressEn  String?  @db.Text
  factoryAddressAr  String?  @db.Text
  workingHoursEn    String?
  workingHoursAr    String?
  mapsUrl           String?
}

# Colina — .env.example (placeholders only, no real values)
# Copy to .env / .env.local as needed per app. Never commit real secrets.

# PostgreSQL connection string used by Prisma (added in Phase 2)
DATABASE_URL="postgresql://user:password@localhost:5432/colina"

# Auth.js / NextAuth secret for the admin app (added in Phase 9)
NEXTAUTH_SECRET="change-me-in-production"

# Seed admin password (Phase 9): read by prisma/seed.ts to set the initial
# admin@example.com password (argon2-hashed, never stored as plaintext).
# If unset, the seed generates a random one and prints it once.
SEED_ADMIN_PASSWORD="change-me-before-seeding"

# Base URL of the admin app, used by Auth.js for callbacks
NEXTAUTH_URL="http://localhost:3001"

# Public site URL, used for canonical links / metadata AND as the expected
# Origin of public POSTs (the contact, maintenance-request and page-view
# endpoints all refuse a cross-origin post).
#
# LOCAL PORT CONVENTION: web on :3000, admin on :3001. Those are also the
# ports `npm run dev:web` / `npm run dev:admin` bind with no arguments, and
# the defaults the e2e suite and README use, so nothing has to be passed
# twice. Two things make a mismatch here expensive rather than obvious:
# NEXT_PUBLIC_* values are inlined at BUILD time, so editing this file
# changes nothing until the next `npm run build`; and serving the app on a
# port other than this one makes every public form POST fail with
# `bad_origin` while the pages themselves still render fine. Keep this file,
# the app's own .env.local, and the port the app is served on in agreement.
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Email provider SMTP settings for lead notifications (wired in Phase 8)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASSWORD="change-me"
CONTACT_NOTIFY_TO="sales@example.com"

# Cloudinary credentials for admin file uploads (wired in Phase 16).
# Used server-side by apps/admin upload Server Actions for images
# (jpg/png/webp) and datasheet PDFs. API key may be public; the API
# secret must never reach client code or be committed.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

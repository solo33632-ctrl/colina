{
  "name": "colina",
  "version": "0.1.0",
  "private": true,
  "description": "Colina corporate website + admin panel monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@colina/web",
    "dev:admin": "npm run dev --workspace=@colina/admin",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@colina/web",
    "build:admin": "npm run build --workspace=@colina/admin",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next-auth@4.24.15": {
      "nodemailer": "10.0.9"
    }
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.27.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.2": true,
    "argon2@0.45.1": true
  }
}
